# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Google OAuth Configuration (from Google Cloud Console)
# Web Client ID is required for Android/iOS idToken verification in Supabase
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_SECRET=your-web-client-secret
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your-release-android-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID_DEBUG=your-debug-android-client-id.apps.googleusercontent.com
